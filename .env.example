# 复制为 .env.local。不要把填好的文件提交进仓库。
# 配置 DEEPSEEK_API_KEY 后，默认调用 deepseek-flash（DeepSeek-V4.1-Flash-1017）。
# 接口是 OpenAI 兼容的，base_url 为 https://api.deepseek.com。
# 没有密钥时使用本地示例，页面会标明。

# 本机 PostgreSQL。把 USER 和 PASSWORD 换成一次性库的账号，不要提交真实口令。
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/study_workbench
# 只在 HTTPS 部署时设为 1。
COOKIE_SECURE=0
# 邀请测试保持 0。回归脚本创建临时账号时才设为 1。
ALLOW_REGISTER=0

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 留空即可。设为 mock 则始终走本地示例；设为 openai 才使用下面的 OpenAI 配置。
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
